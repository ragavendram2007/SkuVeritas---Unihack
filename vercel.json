{
  "version": 2,
  "builds": [
    {
      "src": "frontend_part2/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend_part2/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend_part2/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend_part2/$1"
    }
  ]
}
